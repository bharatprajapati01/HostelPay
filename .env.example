# Copy to .env and fill in.
PORT=5000
# Local: mongodb://127.0.0.1:27017/hostelpay   Atlas: the mongodb+srv:// string from your cluster
MONGODB_URI=mongodb://127.0.0.1:27017/hostelpay
# Any long random string. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
# Comma-separated list of website origins allowed to call this API
CLIENT_ORIGIN=http://localhost:5173,https://hostel-pay-beige.vercel.app
